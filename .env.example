# Copy to .env and adjust. All vars are optional — sensible defaults live
# in sentinelapi/config.py, tuned for local dev with zero external services.

# production refuses example or short secrets and the memory backend (see config.py)
SENTINEL_ENV=development

SENTINEL_BACKEND=memory
# Production only: run the memory backend anyway, for a single process
SENTINEL_ALLOW_MEMORY_BACKEND=false
SENTINEL_REDIS_URL=redis://localhost:6379/0

SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./sentinelapi_audit.db
# false: events are only logged, never written to a database
SENTINEL_AUDIT=true
# Postgres only: the role the app connects as; `sentinel migrate` grants it
# INSERT and SELECT on the audit table and nothing else (append-only)
SENTINEL_AUDIT_APP_ROLE=
# Key of the keyed hashes that replace addresses and accounts in the audit trail and
# the log. Set it (e.g. `openssl rand -hex 32`): unset, it changes at every restart
SENTINEL_AUDIT_HASH_KEY=
# `sentinel purge` deletes events older than this many days
SENTINEL_AUDIT_RETENTION_DAYS=90
# Identical events within this window become one row with a count
SENTINEL_AUDIT_AGGREGATE_SECONDS=60
# Groups waiting to be written; past it new ones are dropped, and the drop is logged
SENTINEL_AUDIT_QUEUE_SIZE=10000

# CIDRs of the reverse proxies in front of the app, e.g. ["172.16.0.0/12"]. Their
# X-Forwarded-For is believed; with none, the direct peer is the client.
SENTINEL_TRUSTED_PROXIES=[]

SENTINEL_RATE_LIMIT_MAX_REQUESTS=60
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
# The request after MAX_REQUESTS in a window gets a 429 with Retry-After.
# WARN_AT logs a MEDIUM event once per window; empty means 80 % of the limit.
SENTINEL_RATE_LIMIT_WARN_AT=
SENTINEL_RATE_LIMIT_EXEMPT_PATHS=["/health", "/ready"]
# Stricter limits per path prefix, on top of the per-client one
SENTINEL_RATE_LIMIT_PATHS={}

SENTINEL_BRUTE_FORCE_WINDOW_SECONDS=900
SENTINEL_BRUTE_FORCE_PER_SOURCE_MEDIUM=5
SENTINEL_BRUTE_FORCE_PER_SOURCE_HIGH=10
SENTINEL_BRUTE_FORCE_PER_USERNAME_HIGH=8
SENTINEL_BRUTE_FORCE_PER_USERNAME_CRITICAL=15
# lock: a targeted account is refused from every source for the window (anyone who
# knows a username can lock its owner out that long). signal: ask for a challenge.
SENTINEL_BRUTE_FORCE_ACCOUNT_ACTION=lock

# Must match the secret/algorithm your app issues JWTs with
SENTINEL_JWT_SECRET=change-me
SENTINEL_JWT_ALGORITHMS=["HS256"]
# Checked when set; empty means not checked
SENTINEL_JWT_AUDIENCE=
SENTINEL_JWT_ISSUER=
SENTINEL_JWT_REPLAY_PATHS=["/auth/refresh"]

# false = log-only ("shadow mode"), useful when first deploying to see
# what SentinelAPI *would* have blocked before you trust it to block for real
SENTINEL_ENFORCE=true

# The demo's attack console at / (off: its routes do not exist)
SENTINEL_DEMO_MODE=false

# Bearer token of the demo's GET /security/events; unset, nobody can read the events
SENTINEL_OPERATOR_TOKEN=

# --- docker compose: read by docker-compose.yml and deploy/docker-compose.prod.yml ---
# Locally each has a development default; the server overlay refuses to start without them.
# SENTINEL_HOSTNAME=sentinelapi.example.org
# POSTGRES_PASSWORD=
# SENTINEL_APP_DB_PASSWORD=
